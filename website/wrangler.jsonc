{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },
  "previews": {}
}
